NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://nd_dev:nd_dev_password@localhost:5432/nagardrishti
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_DEMO_LOGIN=true

# OTP delivery. In development, OTPs are logged by the API when providers are empty.
OTP_SECRET=replace-with-a-long-random-otp-secret
RESEND_API_KEY=
OTP_FROM_EMAIL=NagarDrishti <no-reply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# S3-compatible object storage. Leave empty for local filesystem development.
OBJECT_STORAGE_REQUIRED=false
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Web Push VAPID credentials. Generate with: pnpm exec web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Production reverse proxy
APP_DOMAIN=app.example.com
