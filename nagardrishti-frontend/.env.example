NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://nd_dev:nd_dev_password@localhost:5432/nagardrishti
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_DEMO_LOGIN=true

# Optional Gemini category suggestions. Keep the API key server-side only.
# Default demo classifier is the local Naive Bayes model. Set provider=gemini
# and configure a key only when you want report text sent to Google's API.
AI_CATEGORY_PROVIDER=local-ml
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=8000

# OTP delivery. In development, OTPs are logged by the API when providers are empty.
OTP_SECRET=replace-with-a-long-random-otp-secret
RESEND_API_KEY=
OTP_FROM_EMAIL=NagarDrishti <no-reply@example.com>
OTP_FALLBACK_EMAIL=
OFFICER_EMAILS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# S3-compatible object storage (Cloudflare R2, AWS S3, MinIO).
# Leave empty for local filesystem development with separate private/public folders.
OBJECT_STORAGE_REQUIRED=false
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Dual-bucket architecture for strict citizen photo privacy:
# Private bucket: stores unmodified originals (EXIF preserved for forensic & fraud checks). NO public access.
OBJECT_STORAGE_PRIVATE_BUCKET=
# Public bucket: stores sanitized derivatives (EXIF/GPS/device metadata stripped). Accessible via public CDN.
OBJECT_STORAGE_PUBLIC_BUCKET=
OBJECT_STORAGE_PUBLIC_BASE_URL=
# Backwards compatibility fallback if PRIVATE/PUBLIC buckets are not set individually:
OBJECT_STORAGE_BUCKET=

# Web Push VAPID credentials. Generate with: pnpm exec web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Production reverse proxy
APP_DOMAIN=app.example.com
